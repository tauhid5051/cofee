				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{totalService}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0">
				<reportElement x="157" y="0" width="140" height="20"/>
				<box topPadding="2" leftPadding="2" bottomPadding="2" rightPadding="2">
