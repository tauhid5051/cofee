<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="billReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="131"/>
	<property name="ireport.y" value="0"/>
	<parameter name="startDate" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="endDate" class="java.lang.String"/>
	<parameter name="createdBy" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="due" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="doctor" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="branchCode" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="branchName" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT sma_sales.date,sma_sales.total AS total_bill_amount, CONCAT(COALESCE(warehouse_code,$P{branchCode}), sma_sales.id) AS reference_no, biller, order_discount_id, order_discount, adjust
,SUM(total) Total, CASE WHEN  REPLACE(order_discount_id,'%','')<=25  THEN total_discount WHEN  REPLACE(order_discount_id,'%','')>25 THEN discountable_total*.25 ELSE 0 END GDis
,CASE WHEN  REPLACE(order_discount_id,'%','')>25  THEN discountable_total*(REPLACE(order_discount_id,'%','')-25)/100 ELSE 0 END SPDisc
,SUM(CASE WHEN sma_payments.amount < 0 THEN ABS(sma_payments.amount) ELSE 0 END) AS total_refund, grand_total, paid, shipping,doctor,customer,sma_sales.note FROM `sma_sales` LEFT JOIN `sma_payments` ON `sma_payments`.`sale_id`=`sma_sales`.`id` WHERE `sma_sales`.`created_by` = (CASE WHEN $P{createdBy}='All' THEN sma_sales.created_by ELSE $P{createdBy} END)
AND DATE(`sma_sales`.`date`) BETWEEN $P{startDate} AND $P{endDate}
AND `sma_sales`.`doctor_type` = (CASE WHEN $P{doctor}='All' THEN sma_sales.doctor_type WHEN $P{doctor}='Internal' THEN 1 ELSE 2 END)
GROUP BY `sma_sales`.`id`
ORDER BY `sma_sales`.`date` DESC]]>
	</queryString>
	<field name="date" class="java.sql.Timestamp"/>
	<field name="total_bill_amount" class="java.math.BigDecimal"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="biller" class="java.lang.String"/>
	<field name="order_discount_id" class="java.lang.String"/>
	<field name="order_discount" class="java.math.BigDecimal"/>
	<field name="adjust" class="java.math.BigDecimal"/>
	<field name="Total" class="java.math.BigDecimal"/>
	<field name="GDis" class="java.math.BigDecimal"/>
	<field name="SPDisc" class="java.lang.Double"/>
	<field name="total_refund" class="java.math.BigDecimal"/>
	<field name="grand_total" class="java.math.BigDecimal"/>
	<field name="paid" class="java.math.BigDecimal"/>
	<field name="shipping" class="java.math.BigDecimal"/>
	<field name="doctor" class="java.lang.String"/>
	<field name="customer" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<variable name="billAmount" class="java.lang.Double">
		<variableExpression><![CDATA[$F{order_discount}.doubleValue()+$F{adjust}.doubleValue()+$F{grand_total}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="balance" class="java.lang.Double">
		<variableExpression><![CDATA[$F{grand_total}.doubleValue()-$F{paid}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="totalOrderDiscount" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$V{totalDisc}]]></variableExpression>
	</variable>
	<variable name="totalSPDisc" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{SPDisc}]]></variableExpression>
	</variable>
	<variable name="totalRefund" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_refund}]]></variableExpression>
	</variable>
	<variable name="totalPayable" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{grand_total}]]></variableExpression>
	</variable>
	<variable name="totalPaid" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{paid}]]></variableExpression>
	</variable>
	<variable name="totalBalance" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[new BigDecimal($V{balance})]]></variableExpression>
	</variable>
	<variable name="totalBillAmount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_bill_amount}]]></variableExpression>
	</variable>
	<variable name="startDate" class="java.lang.String"/>
	<variable name="endDate" class="java.lang.String"/>
	<variable name="totalGDis" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{GDis}]]></variableExpression>
	</variable>
	<variable name="totalDisc" class="java.lang.Double">
		<variableExpression><![CDATA[$F{order_discount}.doubleValue()+$F{adjust}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="rowNo" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{reference_no}]]></variableExpression>
	</variable>
