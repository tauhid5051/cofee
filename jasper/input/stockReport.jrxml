	<queryString>
		<![CDATA[SELECT a.product_id , sma_products.`name`, SUM(a.purchase_qty) purchase, SUM(a.sales_qty)  sale  FROM (
SELECT `product_id`, 0 purchase_qty,   SUM(`quantity`) sales_qty FROM `sma_sale_items`
LEFT JOIN `sma_sales` ON `sma_sales`.`id` = `sma_sale_items`.`sale_id`
WHERE DATE(`date`) <= $P{endDate}
GROUP BY `product_id`
UNION ALL
SELECT `product_id`,  SUM(`quantity`) purchase_qty ,  0 sales_qty FROM `sma_purchase_items`
WHERE DATE(`date`) <= $P{endDate}
GROUP BY `product_id` ) a
LEFT JOIN sma_products ON a.product_id = sma_products.id
GROUP BY a.product_id, sma_products.`name`]]>
	</queryString>
